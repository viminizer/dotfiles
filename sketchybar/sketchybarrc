#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ===== Argonaut Palette =====
# Generated by theme/apply.py, so the bar, the terminal, tmux and the window
# borders all draw from one palette. Run `python3 theme/apply.py Argonaut`
# rather than editing these by hand.
export BAR_COLOR=0xff000001
export ITEM_BG_COLOR=0xff222222
export ITEM_BG_FOCUSED=0xff002a3a
export ACCENT_COLOR=0xffff000f
export FG_COLOR=0xfffffaf3
export FG_MUTED=0xff444444
export DARK=0xff000001
export GOLD=0xffff000f
export GOLD_DIM=0xff5c0005
export GREEN=0xff8ce00a
export RED=0xffff000f
export YELLOW=0xffff000f
export MAGENTA=0xffff000f

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=28 \
  blur_radius=0 \
  color=$BAR_COLOR \
  margin=10 \
  corner_radius=6 \
  y_offset=4 \
  padding_left=2 \
  padding_right=2 \
  border_color=$GOLD \
  border_width=1

##### Changing Defaults #####
default=(
  padding_left=3
  padding_right=3
  icon.font="SF Pro:Bold:12.0"
  label.font="SF Pro:Semibold:12.0"
  icon.color=$FG_COLOR
  label.color=$FG_COLOR
  icon.padding_left=6
  icon.padding_right=3
  label.padding_left=3
  label.padding_right=6
  background.color=$ITEM_BG_COLOR
  background.corner_radius=4
  background.height=20
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Aerospace Workspaces #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change

# Launchd can start us before AeroSpace has finished coming up, and without it
# there are no workspaces to build items from. Give it a few seconds.
for _ in $(seq 1 20); do
  workspaces=$(aerospace list-workspaces --all 2>/dev/null) && [ -n "$workspaces" ] && break
  sleep 0.5
done

# `list-workspaces` sorts "0" first, but it is the tenth workspace and alt-0 is
# the last key in the row, so move it to the end to match the keyboard.
ordered=""
zero=""
for sid in $workspaces; do
  if [ "$sid" = "0" ]; then zero="$sid"; else ordered="$ordered $sid"; fi
done
workspaces="$ordered $zero"

for sid in $workspaces; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
    drawing=off \
    background.color=$ITEM_BG_COLOR \
    background.corner_radius=4 \
    background.drawing=on \
    background.height=20 \
    icon="$sid" \
    icon.font="SF Pro:Bold:11.0" \
    icon.color=$FG_COLOR \
    icon.padding_left=8 \
    icon.padding_right=2 \
    label.font="sketchybar-app-font:Regular:13.0" \
    label.padding_right=14 \
    label.padding_left=2 \
    label.color=$FG_COLOR \
    click_script="aerospace workspace $sid"
done

# One pill behind the whole workspace group, the same treatment the status
# items on the right get, so both ends of the bar read as single objects.
sketchybar --add bracket workspaces '/space\..*/' \
  --set workspaces \
  background.drawing=on \
  background.color=$BAR_COLOR \
  background.border_color=$ITEM_BG_COLOR \
  background.border_width=1 \
  background.corner_radius=6 \
  background.height=24

# Invisible item that owns every workspace update. It redraws all the space.*
# items at once, so they never need scripts of their own. The poll is a safety
# net: AeroSpace has no "window opened" event, so without it the icons would go
# stale whenever you open or close a window without switching apps.
sketchybar --add item space_separator left \
  --set space_separator \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  padding_left=6 \
  padding_right=0 \
  update_freq=5 \
  script="$PLUGIN_DIR/space_windows.sh" \
  --subscribe space_separator aerospace_workspace_change front_app_switched

# Front app
sketchybar --add item front_app left \
  --set front_app \
  background.drawing=on \
  background.color=$ACCENT_COLOR \
  background.height=20 \
  icon.font="sketchybar-app-font:Regular:12.0" \
  icon.color=$DARK \
  icon.padding_left=8 \
  icon.padding_right=2 \
  label.font="SF Pro:Bold:11.0" \
  label.color=$DARK \
  label.padding_left=2 \
  label.padding_right=8 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Which AeroSpace mode is active. Hidden in main mode, so it costs no space
# until alt-r or alt-shift-; changes what your keys do.
sketchybar --add item aerospace_mode left \
  --set aerospace_mode \
  drawing=off \
  icon.drawing=off \
  background.drawing=on \
  background.color=$RED \
  background.height=20 \
  label.font="SF Pro:Bold:11.0" \
  label.color=$DARK \
  label.padding_left=8 \
  label.padding_right=8 \
  script="$PLUGIN_DIR/aerospace_mode.sh" \
  --subscribe aerospace_mode aerospace_mode_change

##### Right Items #####

# Clock
sketchybar --add item clock right \
  --set clock \
  icon=󰃰 \
  icon.color=$GOLD \
  icon.font="Hack Nerd Font:Bold:14.0" \
  update_freq=10 \
  click_script="open -a Calendar" \
  script="$PLUGIN_DIR/clock.sh"

# Volume
sketchybar --add item volume right \
  --set volume \
  icon.color=$MAGENTA \
  icon.font="Hack Nerd Font:Bold:14.0" \
  click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

# Battery
sketchybar --add item battery right \
  --set battery \
  icon.color=$GREEN \
  icon.font="Hack Nerd Font:Bold:14.0" \
  update_freq=120 \
  click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Wifi. No sketchybar event fires on a network change, so this polls, and wakes
# are the one moment the SSID is reliably stale.
sketchybar --add item wifi right \
  --set wifi \
  icon.color=$FG_COLOR \
  icon.font="Hack Nerd Font:Bold:14.0" \
  update_freq=30 \
  click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" \
  script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi system_woke

# CPU usage
sketchybar --add item cpu right \
  --set cpu \
  icon=󰻠 \
  icon.color=$YELLOW \
  icon.font="Hack Nerd Font:Bold:14.0" \
  update_freq=5 \
  click_script="open -a 'Activity Monitor'" \
  script="$PLUGIN_DIR/cpu.sh"

# A 56-sample history of the same number the cpu item shows. cpu.sh pushes to
# it, so the reading and the graph can never disagree.
sketchybar --add graph cpu_graph right 56 \
  --set cpu_graph \
  graph.color=$RED \
  graph.fill_color=$GOLD_DIM \
  graph.line_width=1 \
  icon.drawing=off \
  label.drawing=off \
  padding_left=2 \
  padding_right=6 \
  background.height=20

# Swap in use. memswap.sh has been sitting in plugins/ unreferenced; it turns
# red on its own once macOS starts swapping, which is worth seeing.
sketchybar --add item memswap right \
  --set memswap \
  icon="󰓡" \
  icon.color=$FG_MUTED \
  icon.font="Hack Nerd Font:Bold:14.0" \
  update_freq=30 \
  click_script="open -a 'Activity Monitor'" \
  script="$PLUGIN_DIR/memswap.sh"

# One pill around the whole system group rather than five in a row. The items
# above draw no background of their own, so this is the only fill on that side.
sketchybar --add bracket status clock volume battery wifi cpu cpu_graph memswap \
  --set status \
  background.drawing=on \
  background.color=$ITEM_BG_COLOR \
  background.corner_radius=6 \
  background.height=22

##### Force all scripts to run the first time #####
sketchybar --update
